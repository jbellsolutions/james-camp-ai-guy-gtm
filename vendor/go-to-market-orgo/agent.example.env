# Copy to agent.env. This private file is never committed.
AGENT_NAME=ai-guy-go-to-market
BASE_DIR=/srv/ai-guy-go-to-market
HERMES_PORT=18789
A2A_PUBLIC_PORT=9900
A2A_BIND_ADDRESS=127.0.0.1
TZ=America/New_York
AGENT_PERSONA=helpful
HERMES_UID=1000
HERMES_GID=1000

# Dashboard credentials. The installer generates a strong password when blank.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=operator
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# Model: Fireworks primary; Together and OpenRouter are optional fallbacks.
FIREWORKS_API_KEY=fw_REPLACE_ME
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# Human channels. Leave blank to start safely in dashboard/headless mode.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_HOME_CHANNEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=
GATEWAY_ALLOW_ALL_USERS=false

# Honcho memory. When set, the installer activates and syncs Honcho.
HONCHO_API_KEY=
HONCHO_BASE_URL=

# Latitude observability. Metadata is the safe default; sanitized is opt-in.
LATITUDE_API_KEY=
LATITUDE_PROJECT_SLUG=
LATITUDE_CAPTURE_MODE=metadata
LATITUDE_OTLP_ENDPOINT=https://ingest.latitude.so/v1/traces

# A2A stays local until a trusted-peer token and explicit remote bind are set.
A2A_AGENT_NAME=ai-guy-go-to-market
A2A_PEER_TOKENS=
A2A_TRUSTED_PEERS=
A2A_BEARER_TOKEN=
A2A_HOST=127.0.0.1
A2A_PUBLIC_URL=
A2A_RATE_LIMIT=60
A2A_MAX_PINGPONG_TURNS=3
A2A_REPLY_TIMEOUT=300

# Optional go-to-market connections.
INSTANTLY_API_KEY=
DEEPSEEK_API_KEY=
BUSINESS_NAME=
BOOKING_URL=

# Optional business tools (Calendar, email, CRM, proposals, and projects).
# A current Composio session URL is preferred. The two legacy values are read
# only to migrate an existing server and can remain blank on new installs.
COMPOSIO_API_KEY=
COMPOSIO_MCP_URL=
COMPOSIO_USER_ID=
COMPOSIO_MCP_SERVER_ID=

# Optional read-only Notion/Obsidian mirror.
NOTION_TOKEN=
NOTION_PARENT_PAGE=
NOTION_DB_SESSIONS=
NOTION_DB_KANBAN_TASKS=
NOTION_DB_MEMORIES=
NOTION_DB_SKILLS=
NOTION_DB_EVENTS=
SYNC_INTERVAL_SECONDS=60

HERMES_MEM_LIMIT=3g
HERMES_CPUS=2.0

# Agent Bundle is intentionally off for this role. It belongs on the Co-Founder
# unless the owner makes a specific, reviewed exception.
ENABLE_AGENT_BUNDLE=false
